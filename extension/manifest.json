{
  "manifest_version": 3,
  "name": "WebAI Bridge",
  "version": "2.4.0",
  "description": "Connect your IDE agent to the Web AI you already pay for (Gemini, Claude, ChatGPT, DeepSeek, AI Studio) via MCP.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.gemini.google.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://aistudio.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WebAI Bridge Control Panel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://*.gemini.google.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": [
        "content-providers.js",
        "content-upload.js",
        "content-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
