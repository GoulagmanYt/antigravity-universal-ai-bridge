{
    "manifest_version": 3,
    "name": "WebAI Bridge",
    "version": "2.4.0",
    "version_name": "2.4.0-alpha.1",
    "description": "Use the Web AI you already pay for as the Orchestrator of your IDE agent (Gemini, Claude, ChatGPT, DeepSeek, AI Studio).",
    "content_scripts": [{
        "matches": [
            "https://gemini.google.com/*",
            "https://aistudio.google.com/*",
            "https://claude.ai/*",
            "https://chatgpt.com/*",
            "https://chat.openai.com/*",
            "https://chat.deepseek.com/*"
        ],
        "js": ["content.js"]
    }],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "WebAI Bridge",
        "default_popup": "popup.html"
    }
}
